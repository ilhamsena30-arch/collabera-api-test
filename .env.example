# ============================================================================
# Environment configuration template
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# The `.env` file is loaded automatically by Mocha via `--require dotenv/config`.
#
# Select the active environment with NODE_ENV when running tests, e.g.:
#   npm test                # NODE_ENV=development
#   npm run test:staging    # NODE_ENV=staging
# ============================================================================

# --- Target API -------------------------------------------------------------
# Base URL of the API under test (no trailing slash).
# Default target: GoRest (https://gorest.co.in) — see https://gorest.co.in/.
BASE_URL=https://gorest.co.in

# Optional API version prefix. GoRest v2 uses "/public/v2" (direct body).
# The apiBaseUrl becomes https://gorest.co.in/public/v2
API_VERSION=public/v2

# --- Request behaviour ------------------------------------------------------
# Timeout for each HTTP request in milliseconds.
REQUEST_TIMEOUT=10000

# --- Authentication (required for POST/PUT/PATCH/DELETE on GoRest) -----------
# GoRest requires a Bearer access token for all write operations.
# 1. Sign in / create a free account at https://gorest.co.in/
# 2. Generate a Personal Access Token at:
#    https://gorest.co.in/my-account/access-tokens
# 3. Paste it below. It is sent as:  Authorization: Bearer <token>
# NOTE: Never commit a real token — this .env is git-ignored.
AUTH_TOKEN=

# --- Reporting --------------------------------------------------------------
# Mochawesome report directory (relative to project root).
MOCHAWESOME_REPORT_DIR=reports/mochawesome
# JUnit report output file path.
JUNIT_REPORT_PATH=reports/junit/results.xml
# Allure results directory.
ALLURE_RESULTS_DIR=reports/allure-results
